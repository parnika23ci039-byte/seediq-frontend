# ==============================================================================
# SeedIQ Frontend Environment Configuration
# ==============================================================================

# Leave EMPTY for normal web dev (Vite) and normal Vercel deploys — relative
# /api calls will keep working via the dev proxy / same-origin hosting.
#
# Set this to your deployed Flask backend's full URL when building the
# Capacitor mobile app, since the native app has no shared origin with your
# backend and needs an absolute URL to call it, e.g.:
# VITE_API_URL=https://api.seediq.app
VITE_API_URL=
